<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE kcfg SYSTEM "kcfg.dtd">
<kcfg>
  <group name="General">
    <entry name="showClock" type="Bool"><default>false</default></entry>
    <entry name="showDate" type="Bool"><default>false</default></entry>
    <entry name="clock24Hour" type="Bool"><default>true</default></entry>
    <entry name="green" type="String"><default>classic</default></entry>
    <entry name="beamWidth" type="Int"><default>14</default></entry>
    <entry name="speed" type="Int"><default>20</default></entry>
    <entry name="orbs" type="Int"><default>1</default></entry>
    <entry name="shape" type="String"><default>oval</default></entry>
    <entry name="direction" type="String"><default>random</default></entry>
    <entry name="glow" type="Int"><default>70</default></entry>
    <entry name="orbBrightness" type="Int"><default>100</default></entry>
    <entry name="orbitSize" type="Int"><default>100</default></entry>
    <entry name="trailLength" type="Int"><default>35</default></entry>
    <entry name="pulseInterval" type="Int"><default>72</default></entry>
  </group>
</kcfg>
