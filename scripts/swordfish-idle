#!/usr/bin/env bash
# Launch Swordfish after a period of desktop inactivity, and stop it on input.
set -u

CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/swordfish-screensaver.conf"
IDLE_TIMEOUT_MS=300000
GREEN=classic
ORBS=3
BEAM_WIDTH=25
APP=/usr/bin/swordfish-screensaver
POLL_SECONDS=1

if [[ -r "$CONFIG_FILE" ]]; then
    # This is a user-owned shell config file. Only put trusted settings here.
    # shellcheck disable=SC1090
    source "$CONFIG_FILE"
fi

idle_backend=""
if [[ "${XDG_CURRENT_DESKTOP:-}" == *GNOME* ]] && command -v gdbus >/dev/null 2>&1; then
    idle_backend="gnome"
elif [[ "${XDG_SESSION_TYPE:-}" == "x11" ]] && command -v xprintidle >/dev/null 2>&1; then
    idle_backend="x11"
else
    echo "No supported idle detector found. GNOME uses Mutter D-Bus; X11 requires xprintidle." >&2
    exit 1
fi

get_idle_ms() {
    local reply
    if [[ "$idle_backend" == "gnome" ]]; then
        reply=$(gdbus call --session --dest org.gnome.Mutter.IdleMonitor \
            --object-path /org/gnome/Mutter/IdleMonitor/Core \
            --method org.gnome.Mutter.IdleMonitor.GetIdletime 2>/dev/null) || return 1
        # Extract the first integer from gdbus's "(uint64 N,)" response.
        if [[ "$reply" =~ ([0-9]+) ]]; then
            printf '%s\n' "${BASH_REMATCH[1]}"
            return 0
        fi
        return 1
    fi
    xprintidle
}

if [[ ! -x "$APP" ]]; then
    echo "Swordfish executable not found at $APP" >&2
    exit 1
fi
if ! [[ "$IDLE_TIMEOUT_MS" =~ ^[0-9]+$ ]] || (( IDLE_TIMEOUT_MS < 10000 )); then
    echo "IDLE_TIMEOUT_MS must be an integer of at least 10000." >&2
    exit 2
fi
if ! [[ "$ORBS" =~ ^[1-8]$ ]]; then
    echo "ORBS must be an integer from 1 through 8." >&2
    exit 2
fi
if ! [[ "$BEAM_WIDTH" =~ ^([5-9]|[1-5][0-9]|60)(\.[0-9]+)?$ ]]; then
    echo "BEAM_WIDTH must be between 5 and 60." >&2
    exit 2
fi
case "$GREEN" in
    classic|lime|emerald|teal) ;;
    *) echo "Invalid GREEN palette: $GREEN" >&2; exit 2 ;;
esac

child=""
stop_child() {
    if [[ -n "$child" ]] && kill -0 "$child" 2>/dev/null; then
        kill -TERM "$child" 2>/dev/null || true
        wait "$child" 2>/dev/null || true
    fi
    child=""
}
trap 'stop_child; exit 0' INT TERM HUP

while true; do
    idle_ms=$(get_idle_ms 2>/dev/null) || {
        echo "Unable to query desktop idle time; stopping launcher." >&2
        stop_child
        exit 1
    }
    if [[ "$idle_ms" =~ ^[0-9]+$ ]] && (( idle_ms >= IDLE_TIMEOUT_MS )); then
        "$APP" --green "$GREEN" --orbs "$ORBS" --beam-width "$BEAM_WIDTH" &
        child=$!
        while kill -0 "$child" 2>/dev/null; do
            sleep "$POLL_SECONDS"
            idle_ms=$(get_idle_ms 2>/dev/null) || {
                echo "Idle monitor became unavailable; stopping Swordfish." >&2
                stop_child
                exit 1
            }
            if [[ ! "$idle_ms" =~ ^[0-9]+$ ]] || (( idle_ms < IDLE_TIMEOUT_MS )); then
                stop_child
                break
            fi
        done
        child=""
    else
        sleep "$POLL_SECONDS"
    fi
done
